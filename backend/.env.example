# Puerto del servidor
PORT=3000

# Cadena de conexión a PostgreSQL (Neon en producción)
DATABASE_URL=postgresql://usuario:password@localhost:5432/turnomed

# Secreto para firmar los JWT. Generar uno largo y aleatorio.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Origen permitido para CORS (el frontend)
FRONTEND_URL=http://localhost:5173

# Zona horaria del centro médico
CLINIC_TZ=America/Argentina/Buenos_Aires

# production | development
NODE_ENV=development

# Contraseñas iniciales del seed. En producción son obligatorias.
# En desarrollo, si quedan vacías, se usan Admin1234 y Doctor1234.
INITIAL_ADMIN_PASSWORD=
INITIAL_DOCTOR_PASSWORD=
